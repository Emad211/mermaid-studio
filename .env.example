# Public domain and canonical origin for Nemodara production.
DOMAIN=nemodara.ir
SITE_URL=https://nemodara.ir
SITE_NAME=نمودارا
SEO_LAST_MODIFIED=2026-07-15
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
SEO_AUTHOR_NAME=تیم تحریریه نمودارا

# Web server
HOST=0.0.0.0
PORT=4321
TRUST_PROXY=true
FORCE_HSTS=false
NO_OPEN=1
# Optional stable cache-busting identifier, e.g. a Git commit SHA.
ASSET_VERSION=

# Privacy-first first-party analytics and protected revenue dashboard.
ANALYTICS_ENABLED=true
ANALYTICS_RESPECT_DNT=true
ANALYTICS_DATA_DIR=/data/analytics
ANALYTICS_TIME_ZONE=Asia/Tehran
ANALYTICS_RETENTION_DAYS=400
ANALYTICS_ESTIMATED_RPM_RIAL=0
ANALYTICS_RATE_WINDOW_MS=60000
ANALYTICS_RATE_MAX=240
ANALYTICS_SEARCH_MAX_ROWS=100000
ANALYTICS_REVENUE_MAX_ENTRIES=20000
ANALYTICS_COUNTRY_HEADER=
ANALYTICS_ADMIN_USER=admin
# Required: generate a unique value, for example with: openssl rand -base64 32
ANALYTICS_ADMIN_PASSWORD=
# Required: stable HMAC secret; generate with: openssl rand -hex 32
ANALYTICS_HASH_SECRET=

# Public render API limits
RENDER_RATE_WINDOW_MS=60000
RENDER_RATE_MAX=30
RENDER_CONCURRENCY=2
RENDER_QUEUE_MAX=20
JSON_BODY_LIMIT=256kb
# Keep disabled in production so Mermaid source is never placed in URLs/logs.
RENDER_GET_ENABLED=false

# Chromium
# The official container runs as a non-root user, with a read-only filesystem,
# an internal-only backend network and bounded temporary storage. Chromium's
# process sandbox is disabled because it is not available on common Docker hosts.
PUPPETEER_NO_SANDBOX=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Iranian publisher advertising. Nothing is loaded until every required value
# is configured. Copy the exact script URL and placement IDs from your own panel.
ADS_ENABLED=false
# Set true only after testing real placements and receiving publisher approval.
ADS_PUBLISHER_VALIDATED=false
ADS_PROVIDER=yektanet
ADS_SCRIPT_URL=
ADS_SCRIPT_ID=
ADS_ALLOWED_ORIGINS=
ADS_LOAD_DELAY_MS=700
ADS_NO_FILL_TIMEOUT_MS=8000
ADS_SLOT_HOME_TOP=
ADS_SLOT_HOME_INLINE=
ADS_SLOT_TEMPLATES_TOP=
ADS_SLOT_TEMPLATES_INLINE=
ADS_SLOT_LEARN_TOP=
ADS_SLOT_LEARN_INLINE=
ADS_SLOT_LEARN_FEED=
ADS_SLOT_ARTICLES_TOP=
ADS_SLOT_ARTICLES_INLINE=
ADS_SLOT_ARTICLE_TOP=
ADS_SLOT_ARTICLE_MID=
ADS_SLOT_ARTICLE_END=

# Optional editor monetization. Use a second origin on the same deployment so
# publisher scripts cannot access the editor DOM or Mermaid source.
ADS_EDITOR_ENABLED=false
ADS_EDITOR_REQUIRE_CROSS_ORIGIN=true
ADS_EDITOR_FRAME_ORIGIN=https://ads.nemodara.ir
# Optional dedicated secret; ANALYTICS_HASH_SECRET is used as a secure fallback.
ADS_EDITOR_TOKEN_SECRET=
ADS_EDITOR_TOKEN_TTL_SECONDS=300
ADS_EDITOR_NO_FILL_TIMEOUT_MS=8000
ADS_EDITOR_TRAFFIC_PERCENT=25
ADS_EDITOR_LOAD_DELAY_MS=1800
ADS_SLOT_EDITOR_RAIL=
ADS_SLOT_EDITOR_DOCK=

# Admin growth control center and live SEO audit.
SEO_AUDIT_TIMEOUT_MS=8000

# Optional direct Google Search Console sync via a service account.
# Add the service-account email as a user of the exact Search Console property.
GSC_ENABLED=false
GSC_SITE_URL=sc-domain:nemodara.ir
GSC_SERVICE_ACCOUNT_FILE=
# Alternative to a mounted file: base64-encoded service-account JSON.
GSC_SERVICE_ACCOUNT_B64=
GSC_ROW_LIMIT=25000
GSC_MAX_ROWS=100000
GSC_SEARCH_TYPE=web
GSC_TIMEOUT_MS=15000

# Optional IndexNow submission. The key is served at /<key>.txt when enabled.
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_TIMEOUT_MS=10000
