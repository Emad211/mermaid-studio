# Web server
HOST=0.0.0.0
PORT=4321
TRUST_PROXY=true
FORCE_HSTS=false
NO_OPEN=1

# Public render API limits
RENDER_RATE_WINDOW_MS=60000
RENDER_RATE_MAX=30
RENDER_CONCURRENCY=2
RENDER_QUEUE_MAX=20
JSON_BODY_LIMIT=256kb

# Chromium
# Prefer a non-root container so Chromium's sandbox can stay enabled.
PUPPETEER_NO_SANDBOX=false
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Optional direct sponsor shown in the editor; no third-party ad script is loaded.
SPONSOR_NAME=
SPONSOR_URL=
SPONSOR_LABEL=با حمایت
