# Web server
HOST=0.0.0.0
PORT=4321
TRUST_PROXY=true
FORCE_HSTS=false
NO_OPEN=1

# Public render API limits
RENDER_RATE_WINDOW_MS=60000
RENDER_RATE_MAX=30
RENDER_CONCURRENCY=2
RENDER_QUEUE_MAX=20
JSON_BODY_LIMIT=256kb

# Chromium
# Prefer a non-root container so Chromium's sandbox can stay enabled.
PUPPETEER_NO_SANDBOX=false
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Iranian publisher advertising. Nothing is loaded until every required value
# is configured. Copy the exact script URL and placement IDs from your panel.
ADS_ENABLED=false
ADS_PROVIDER=yektanet
ADS_SCRIPT_URL=
ADS_SCRIPT_ID=
ADS_ALLOWED_ORIGINS=
ADS_LOAD_DELAY_MS=700
ADS_SLOT_HOME_TOP=
ADS_SLOT_HOME_INLINE=
ADS_SLOT_TEMPLATES_TOP=
ADS_SLOT_TEMPLATES_INLINE=
ADS_SLOT_LEARN_TOP=
ADS_SLOT_LEARN_INLINE=
