NODE_ENV=production
HOST=0.0.0.0
PORT=4321

# Enable public-product defaults (stricter limits and no automatic browser opening).
MSTUDIO_PUBLIC_MODE=1

# Keep this disabled on an internet-facing deployment.
MSTUDIO_ALLOW_UNSAFE_MERMAID=0

# Render protection.
MSTUDIO_RATE_LIMIT=40
MSTUDIO_RENDER_CONCURRENCY=2
MSTUDIO_RENDER_QUEUE=20
MSTUDIO_MAX_CODE_LENGTH=120000
MSTUDIO_MAX_CSS_LENGTH=20000
MSTUDIO_MAX_CONFIG_LENGTH=40000

# Set to 1 only when a trusted reverse proxy supplies the client IP.
TRUST_PROXY=1

# Optional direct sponsor shown on the landing page and editor.
SPONSOR_NAME=
SPONSOR_URL=
SPONSOR_NOTE=
