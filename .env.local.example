# Local Docker only. The setup scripts copy this file to .env.local and generate secrets.
LOCAL_BIND_ADDRESS=127.0.0.1
LOCAL_SITE_HOST=localhost
LOCAL_PORT=4321
LOCAL_IMAGE=mermaid-studio:local
SITE_NAME=نمودارا — محیط لوکال

# Local admin panel credentials. Leave empty in this template.
ANALYTICS_ADMIN_USER=admin
ANALYTICS_ADMIN_PASSWORD=
ANALYTICS_HASH_SECRET=

# Local first-party analytics. Data survives container restarts in a named volume.
ANALYTICS_RESPECT_DNT=true
ANALYTICS_TIME_ZONE=Asia/Tehran
ANALYTICS_RETENTION_DAYS=90
ANALYTICS_ESTIMATED_RPM_RIAL=0
ANALYTICS_RATE_WINDOW_MS=60000
ANALYTICS_RATE_MAX=600
ANALYTICS_COUNTRY_HEADER=

# Render limits suitable for a developer workstation.
RENDER_RATE_WINDOW_MS=60000
RENDER_RATE_MAX=120
RENDER_CONCURRENCY=2
RENDER_QUEUE_MAX=20
JSON_BODY_LIMIT=256kb
SEO_AUDIT_TIMEOUT_MS=12000

# The local stack intentionally keeps all external integrations disabled.
ADS_ENABLED=false
GSC_ENABLED=false
INDEXNOW_ENABLED=false
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
SEO_AUTHOR_NAME=تیم تحریریه نمودارا
# Article placements are configured only in production.
ADS_SLOT_LEARN_FEED=
ADS_SLOT_ARTICLES_TOP=
ADS_SLOT_ARTICLES_INLINE=
ADS_SLOT_ARTICLE_TOP=
ADS_SLOT_ARTICLE_MID=
ADS_SLOT_ARTICLE_END=
